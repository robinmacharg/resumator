<!--
  Resumator DOCX theme: Word style definitions for the custom-style names cv_convert emits.
  cv_convert inserts these <w:style> elements into pandoc's default reference.docx at render
  time (the w: prefix is declared there). Paragraph styles come from divs, character styles
  from spans. Names without an entry here fall back to plain body text.
  PDF is the primary output (themes/default.typ); this file keeps the DOCX looking as it did
  before themes, not like the PDF.
-->
<w:style w:type="paragraph" w:customStyle="1" w:styleId="candidate-name">
  <w:name w:val="candidate-name" />
  <w:basedOn w:val="Heading1" />
  <w:next w:val="BodyText" />
</w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="candidate-title">
  <w:name w:val="candidate-title" />
  <w:basedOn w:val="BodyText" />
  <w:rPr><w:b /><w:bCs /></w:rPr>
</w:style>
