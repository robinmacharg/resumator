# Fictional sample settings for first run. Values are made up: no real keys.
# Import with: python3 -m resumator --action settings-import --env-file examples/settings.example.env

MODEL_PROVIDER=openai
CV_FAST_MODE=false
CV_THEME=compact
CV_FONT_PRIORITY=Calibri,Arial,Helvetica

# swiftlet: a made-up OpenAI-compatible server on localhost
OPENAI_API_KEY=sk-example-not-a-real-key-0000
OPENAI_API_URL=http://localhost:8080/v1/chat/completions
OPENAI_MODEL=swiftlet-1
